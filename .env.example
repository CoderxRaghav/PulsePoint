# Firebase web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Server-only Supabase credentials. Use the project URL (without /rest/v1).
# Never expose the secret/service-role key to browser code.
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_SECRET_KEY=your_server_secret_key

# Server-only Firebase Admin service-account values used to verify ID tokens
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key_contents\n-----END PRIVATE KEY-----\n"

# Optional GitHub OAuth client ID for GitHub Sign-In via Firebase
NEXT_PUBLIC_FIREBASE_GITHUB_CLIENT_ID=your_github_client_id
