# Firebase web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Server-only Supabase credentials. Use the project URL (without /rest/v1).
# Never expose the secret/service-role key to browser code.
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_SECRET_KEY=your_server_secret_key

# Server-only Firebase Admin service-account values used to verify ID tokens
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key_contents\n-----END PRIVATE KEY-----\n"

# Server-only curator allowlist for the hackathons admin API (/api/admin/*).
# Comma-separated Firebase UIDs. Never expose with a NEXT_PUBLIC_ prefix and
# never commit real UIDs. Empty means no curator access (safe default).
HACKATHON_CURATOR_UIDS=

# Server-only Groq API key for the AI Assistant (Phase 7A, /api/ai/assistant).
# Never expose with a NEXT_PUBLIC_ prefix. Absent key means the assistant is off.
GROQ_API_KEY=
# AI Assistant kill switch (Phase 7A). Any value other than "true" disables the
# assistant — the endpoint returns 503 and the /assistant UI shows unavailable.
AI_ASSISTANT_ENABLED=false

# Optional GitHub OAuth client ID for GitHub Sign-In via Firebase
NEXT_PUBLIC_FIREBASE_GITHUB_CLIENT_ID=your_github_client_id
